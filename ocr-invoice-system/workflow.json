    {
      "parameters": {
        "jsCode": "const base = $('Validate & score').first().json;\n\nconst decision = $json.Decision || null;\n\nlet status = base.status;\n\nif (decision === 'Approve') status = 'approved_by_human';\n\nif (decision === 'Reject') status = 'rejected_by_human';\n\nreturn { json: {\n\n  ...base,\n\n  reviewer_decision: decision || 'n/a (auto)',\n\n  reviewer_comment: $json['Reviewer comment'] || '',\n\n  status\n\n}};\n "
